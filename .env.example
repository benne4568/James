# Eigener API-Schlüssel nur für Klausi (Anthropic Console, mit Ausgabenlimit)
ANTHROPIC_API_KEY=
# Langes, selbst ausgedachtes Passwort. Home Assistant meldet sich damit bei Klausi an.
KLAUSI_API_TOKEN=
# ha-mcp-Server, kommagetrennt als kurzname=adresse
# Bat Cave im Heimnetz: Adresse aus dem Log der App "Home Assistant MCP Server",
# Host durch die IP des HA-Servers ersetzen. Opa: Adresse über den Nabu-Casa-Webhook-Proxy.
KLAUSI_MCP_SERVERS=bat=http://192.168.178.X:9583/GEHEIMER-PFAD
KLAUSI_MODEL=claude-opus-5-5
KLAUSI_EFFORT=low
KLAUSI_NAME=Klausi
KLAUSI_OWNER=Benedikt
