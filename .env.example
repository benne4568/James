# Eigener API-Schlüssel nur für James (Anthropic Console, mit Ausgabenlimit)
ANTHROPIC_API_KEY=
# Langes, selbst ausgedachtes Passwort. Home Assistant meldet sich damit bei James an.
JAMES_API_TOKEN=
# ha-mcp-Server, kommagetrennt als kurzname=adresse
# Bat Cave im Heimnetz: Adresse aus dem Log der App "Home Assistant MCP Server",
# Host durch die IP des HA-Servers ersetzen. Opa: Adresse über den Nabu-Casa-Webhook-Proxy.
JAMES_MCP_SERVERS=bat=http://192.168.178.X:9583/GEHEIMER-PFAD
JAMES_MODEL=claude-opus-5-5
JAMES_EFFORT=low
JAMES_NAME=James
JAMES_OWNER=Benedikt
