# Kopieren nach /etc/klausi/guard.env, dann: sudo chmod 600 /etc/klausi/guard.env

# Langes Zufallspasswort: openssl rand -hex 32
KLAUSI_TOKEN=

# ha-mcp-Server, Format name=url, mehrere mit Komma.
# Adresse steht im Log der App „Home Assistant MCP Server“.
KLAUSI_UPSTREAMS=bat=http://homeassistant.local:9583/<geheimer-pfad>

KLAUSI_OWNER=Benedikt
KLAUSI_PORT=8100
KLAUSI_DATA_DIR=/var/lib/klausi
# Weitere Teile von Entity-IDs, die immer eine Rückfrage brauchen (Komma-getrennt)
KLAUSI_EXTRA_SENSITIVE=
# Werkzeuge, die nie ausgeführt werden (Komma-getrennt), z. B. ha_restart
KLAUSI_DENY_TOOLS=
