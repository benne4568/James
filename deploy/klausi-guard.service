[Unit]
Description=Klausi-Wächter (Sicherheitsregeln zwischen OpenJarvis und Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
User=klausi
WorkingDirectory=/opt/klausi/guard
EnvironmentFile=/etc/klausi/guard.env
ExecStart=/opt/klausi/.venv/bin/python -m klausi_guard
StateDirectory=klausi
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
