# Als Benutzer-Dienst: ~/.config/systemd/user/openjarvis.service
# Pfad zu jarvis vorher mit `command -v jarvis` prüfen und unten eintragen.
[Unit]
Description=OpenJarvis-Server für Klausi
After=network-online.target klausi-guard.service

[Service]
EnvironmentFile=%h/.openjarvis/klausi.env
ExecStart=%h/.local/bin/jarvis serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
